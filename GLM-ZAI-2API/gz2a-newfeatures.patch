+// trimSuffixFold removes suffix from s case-insensitively. on reports whether
+// the suffix matched.
+func trimSuffixFold(s, suffix string) (string, bool) {
+	if len(s) > len(suffix) && strings.EqualFold(s[len(s)-len(suffix):], suffix) {
+		return s[:len(s)-len(suffix)], true
+	}
+	return s, false
+}
+
+// isReasoningDisableValue reports whether a reasoning_effort value means
+// "thinking off".
+func isReasoningDisableValue(v string) bool {
+	switch strings.ToLower(strings.TrimSpace(v)) {
+	case "none", "off", "disabled", "disable", "false", "no", "minimal":
+		return true
+	}
+	return false
+}
+
+// isReasoningEnableValue reports whether a reasoning_effort value is a bare
+// enable (without an explicit level).
+func isReasoningEnableValue(v string) bool {
+	switch strings.ToLower(strings.TrimSpace(v)) {
+	case "on", "enabled", "enable", "true", "yes", "default", "low", "medium", "high", "max":
+		return true
+	}
+	return false
+}
